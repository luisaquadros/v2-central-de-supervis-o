{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "v2-central-de-supervis-o",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 0.2 },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "previews": {},
  "main": "src/server/worker.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "WRITE_COORDINATOR",
        "class_name": "WriteCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-write-coordinator",
      "new_sqlite_classes": [
        "WriteCoordinator"
      ]
    }
  ]
}
